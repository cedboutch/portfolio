---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { resolveIcon } from '../lib/icons'

const all = await getCollection('experience')
const byType = (type: 'work' | 'education') =>
  all
    .filter((e) => e.data.type === type)
    .sort((a, b) => a.data.order - b.data.order)

const tabs = [
  { id: 'work', label: 'Travail', items: byType('work') },
  { id: 'education', label: 'Éducation', items: byType('education') },
] as const
---

<section id="experience" class="resumeSection">
  <h2 class="heading">Mon expérience</h2>

  <div class="resumeBox">
    <div class="tabButtons" role="tablist" aria-label="Type d'expérience">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            class:list={['tabButton', i === 0 && 'activeTab']}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.id}`}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    {
      tabs.map((tab, i) => (
        <div
          class="tabContent"
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          hidden={i !== 0}
        >
          {tab.items.map(({ data }) => (
            <article class="itemCard" data-reveal>
              <div class="itemCardContent">
                <div
                  class="logoContainer"
                  style={data.logoPadding ? `padding: ${data.logoPadding}` : undefined}
                >
                  <Image
                    src={data.logo}
                    alt={`Logo ${data.place}`}
                    class="companyLogo"
                    widths={[90, 140, 280]}
                    sizes="(max-width: 768px) 90px, 140px"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="itemBody">
                  <div class="itemHeader">
                    <h3>{data.role}</h3>
                    <span>{data.date}</span>
                  </div>
                  <p class="itemPlace" style={`color: ${data.color}`}>
                    {data.place}
                  </p>
                  {data.details.length > 0 && (
                    <ul class="detailList">
                      {data.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  )}
                  {data.techBadges.length > 0 && (
                    <div class="techBadges">
                      {data.techBadges.map((badge) => {
                        const icon = resolveIcon(badge.icon, badge.variant)
                        return (
                          <span class="techBadge">
                            {icon && (
                              <img
                                src={icon.url}
                                alt=""
                                class:list={[
                                  'techBadgeIcon',
                                  icon.needsBackdrop && 'iconChip',
                                ]}
                                width="14"
                                height="14"
                                loading="lazy"
                                decoding="async"
                              />
                            )}
                            <span>{badge.name}</span>
                          </span>
                        )
                      })}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]')
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]')

  const select = (id: string) => {
    for (const tab of tabs) {
      const on = tab.dataset.tab === id
      tab.classList.toggle('activeTab', on)
      tab.setAttribute('aria-selected', String(on))
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.panel !== id
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => select(tab.dataset.tab!))
  }
</script>

<style>
  .resumeSection {
    padding: 3rem 5%;
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .heading {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .resumeBox {
    position: relative;
    border-radius: 14px;
    background: transparent;
    padding: 1.5rem;
    width: 100%;
    /* Contains the negative z-index pseudo-elements below, so they layer
       against this box rather than escaping behind the page background. */
    isolation: isolate;
  }

  .resumeBox::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: conic-gradient(
      from 0deg,
      var(--accent-teal),
      var(--accent-pink),
      var(--accent-lavender),
      var(--accent-teal)
    );
    z-index: -2;
  }

  .resumeBox::before {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 12px;
    background: var(--color-bg);
    z-index: -1;
  }

  .tabButtons {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  .tabButton {
    border: 1px solid rgba(228, 228, 228, 0.2);
    background: transparent;
    color: var(--color-text-strong);
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-weight: 600;
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }

  .tabButton:hover {
    color: var(--color-text);
    border-color: rgba(168, 213, 162, 0.6);
  }

  .tabButton.activeTab,
  .tabButton.activeTab:hover {
    background: var(--accent-green);
    color: var(--color-bg);
    border-color: var(--accent-green);
    box-shadow: 0 2px 6px rgba(168, 213, 162, 0.15);
  }

  .tabContent {
    display: grid;
    gap: 1rem;
  }

  .tabContent[hidden] {
    display: none;
  }

  .itemCard {
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1.2rem;
    background: var(--surface-raised);
    transition:
      transform var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .itemCard:hover {
    border-color: rgba(179, 156, 208, 0.4);
    transform: translateY(-2px);
  }

  .itemCardContent {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .logoContainer {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 12px;
    padding: 10px;
  }

  .companyLogo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .itemBody {
    flex: 1;
    min-width: 0;
    flex-basis: 200px;
  }

  .itemHeader {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.4rem;
  }

  .itemHeader h3 {
    font-size: 1.1rem;
  }

  .itemHeader span {
    font-size: 0.9rem;
    color: var(--color-text-subtle);
  }

  .itemPlace {
    margin-bottom: 0.45rem;
    font-weight: 600;
  }

  .detailList {
    list-style: disc;
    padding-left: 1.2rem;
    margin: 0.5rem 0 0.75rem 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .detailList li {
    margin-bottom: 0.35rem;
  }

  .techBadges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .techBadge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem 0.25rem 0.45rem;
    border-radius: 14px;
    border: 1px solid var(--border-faint);
    background: var(--surface-pill);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 500;
    cursor: default;
    transition:
      border-color var(--dur-instant) ease-out,
      background var(--dur-instant) ease-out;
  }

  .techBadge:hover {
    border-color: var(--hover-lavender-border);
    background: var(--hover-lavender-bg);
  }

  .techBadgeIcon {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .iconChip {
    background: rgba(228, 228, 228, 0.92);
    padding: 1px;
  }

  @media (max-width: 768px) {
    .heading {
      font-size: 1.8rem;
    }

    .resumeBox {
      padding: 1rem;
    }

    .itemCardContent {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .logoContainer {
      width: 90px;
      height: 90px;
    }

    .itemBody {
      width: 100%;
      flex-basis: auto;
    }

    .itemHeader {
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
    }

    .itemHeader h3 {
      font-size: 1rem;
    }

    .detailList {
      text-align: left;
      font-size: 0.82rem;
    }

    .techBadges {
      justify-content: center;
    }
  }
</style>
