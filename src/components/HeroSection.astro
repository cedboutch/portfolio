---
import { Image } from 'astro:assets'
import heroImg from '../assets/HeroImage.webp'
---

<section id="about" class="heroContainer">
  <div class="heroContent">
    <h1 class="name">Cédric Bouchard</h1>
    <p class="subtitle">Étudiant en génie logiciel</p>

    <div class="contactInfo">
      <div class="contactRow">
        <svg class="contactIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>418-871-2051</span>
      </div>
      <div class="contactRow">
        <svg class="contactIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <a href="mailto:cedric.bouchard.02@hotmail.com">cedric.bouchard.02@hotmail.com</a>
      </div>
      <div class="contactRow">
        <svg class="contactIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Québec, Canada</span>
      </div>
    </div>

    <div class="socials">
      <a href="https://github.com/cedboutch" target="_blank" rel="noopener noreferrer" class="socialLink socialGithub" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="12" class="iconBg"></circle>
          <path fill="currentColor" d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
        </svg>
      </a>
      <a href="https://linkedin.com/in/cedric-bouchard" target="_blank" rel="noopener noreferrer" class="socialLink socialLinkedin" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" class="iconBg"></path>
          <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="heroImageContainer">
    <div class="imageRing">
      {/* LCP element. Rendered at 360px CSS (720px @2x) instead of shipping the
          original 532KB source, and eagerly loaded with high priority.

          WebP only, deliberately: the source is already WebP, so re-encoding to
          AVIF came out *larger* at every width (30KB vs 19KB at 720w). A
          <Picture> with an AVIF source would cost bytes and add a 3.9MB PNG
          fallback for no benefit.

          `width` caps the plain `src` fallback at 720px; without it Astro points
          src at the untouched 3877px original — 299KB for a 360px circle. */}
      <Image
        src={heroImg}
        alt="Cédric Bouchard"
        class="heroImage"
        widths={[220, 260, 360, 520, 720]}
        sizes="(max-width: 480px) 220px, (max-width: 768px) 260px, 360px"
        width={720}
        format="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .heroContainer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--content-width);
    margin: 0 auto;
    min-height: 80vh;
    padding: 2rem 5%;
    gap: 4rem;
  }

  /* Left content */
  .heroContent {
    flex: 0 1 auto;
    max-width: 600px;
  }

  .name {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.15;
  }

  .subtitle {
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--accent-teal);
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
  }

  /* Contact info */
  .contactInfo {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }

  .contactRow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: rgba(228, 228, 228, 0.65);
  }

  .contactRow a {
    color: rgba(228, 228, 228, 0.65);
    transition: color var(--dur-fast) ease;
  }

  .contactRow a:hover {
    color: var(--accent-pink);
  }

  .contactIcon {
    width: 18px;
    height: 18px;
    color: var(--accent-lavender);
    flex-shrink: 0;
  }

  /* Social links */
  .socials {
    display: flex;
    gap: 1rem;
  }

  .socialLink {
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform var(--dur-base) var(--ease-spring),
      filter var(--dur-base) ease;
  }

  .socialLink svg {
    width: 40px;
    height: 40px;
  }

  .socialLink:hover {
    transform: translateY(-4px) scale(1.05);
  }

  .iconBg {
    fill: var(--color-bg);
    transition: opacity var(--dur-base) ease;
  }

  .socialGithub {
    color: var(--accent-pink);
  }

  .socialGithub:hover {
    filter: brightness(1.08);
  }

  .socialLinkedin {
    color: var(--accent-orange);
  }

  .socialLinkedin:hover {
    filter: brightness(1.08);
  }

  /* Right — circular photo */
  .heroImageContainer {
    flex: 0 1 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .imageRing {
    position: relative;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    padding: 8px;
    background: transparent;
    overflow: hidden;
    transform: translateZ(0);
  }

  .imageRing::after {
    content: '';
    position: absolute;
    /* Oversize it so we don't rely on its border-radius while spinning */
    inset: -10%;
    background: conic-gradient(
      from 0deg,
      var(--accent-teal),
      var(--accent-pink),
      var(--accent-lavender),
      var(--accent-teal)
    );
    z-index: 0;
    animation: spin 5s linear infinite;
    will-change: transform;
  }

  .imageRing::before {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--color-bg);
    z-index: 1;
  }

  .heroImage {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
  }

  /* The ring spins forever; stop it outright rather than just shortening it,
     since the global reduced-motion rule only clamps duration. */
  @media (prefers-reduced-motion: reduce) {
    .imageRing::after {
      animation: none;
    }
  }

  /* Tablet / Mobile */
  @media (max-width: 768px) {
    .heroContainer {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
      min-height: auto;
      padding-top: 1.5rem;
    }

    .heroContent {
      max-width: 100%;
    }

    .contactInfo {
      align-items: center;
    }

    .socials {
      justify-content: center;
    }

    .heroImageContainer {
      flex: none;
    }

    .imageRing {
      width: 260px;
      height: 260px;
    }

    .name {
      font-size: 2.2rem;
    }

    .subtitle {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
  }

  /* Small phones */
  @media (max-width: 480px) {
    .imageRing {
      width: 220px;
      height: 220px;
    }

    .name {
      font-size: 1.8rem;
    }
  }
</style>
